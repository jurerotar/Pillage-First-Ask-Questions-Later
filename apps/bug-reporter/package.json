{
  "name": "@pillage-first/bug-reporter",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "bug-reporter": "node --watch --env-file=.env src/server.ts",
    "start": "node src/server.ts",
    "type-check": "tsc --noEmit",
    "lint:check": "biome lint --no-errors-on-unmatched",
    "format:check": "biome ci --linter-enabled=false",
    "test": "node --test --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2"
  }
}
