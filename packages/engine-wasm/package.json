  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/plugin-transform-block-scoping": "8.0.7",
    "@types/node": "25.9.1",
    "esbuild": "0.28.2",
    "rolldown": "1.1.5",
    "vitest": "5.0.3"
  }
