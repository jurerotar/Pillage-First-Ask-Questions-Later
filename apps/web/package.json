{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@pillage-first/web",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Jure Rotar <hello@jurerotar.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurerotar/Pillage-First-Ask-Questions-Later",
    "directory": "apps/web"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:dev": "react-router build --mode development",
    "preview": "vite preview",
    "lint:check": "biome lint --no-errors-on-unmatched",
    "lint": "biome lint --fix --no-errors-on-unmatched",
    "lint:check/oxlint": "oxlint --type-aware",
    "lint/oxlint": "oxlint --type-aware --fix",
    "format:check": "biome ci --linter-enabled=false",
    "format": "biome check --write --no-errors-on-unmatched",
    "knip": "knip",
    "localize": "i18next-cli extract",
    "type-check": "react-router typegen && tsc",
    "test": "vitest"
  },
  "dependencies": {
    "@grafana/faro-react": "2.9.0",
    "@grafana/faro-web-sdk": "2.9.0",
    "@hookform/resolvers": "5.7.1",
    "@mantine/hooks": "9.5.1",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@pillage-first/api": "*",
    "@pillage-first/db": "*",
    "@pillage-first/game-assets": "*",
    "@pillage-first/graphics": "0.1.2",
    "@pillage-first/mocks": "*",
    "@pillage-first/types": "*",
    "@pillage-first/utils": "*",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.3.6",
    "isbot": "5.2.1",
    "moderndash": "4.0.2",
    "peerjs": "1.5.5",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-i18next": "17.0.11",
    "react-icons": "5.7.0",
    "react-icons-sprite": "1.1.1",
    "react-router": "8.3.0",
    "react-tooltip": "5.30.0",
    "react-window": "2.3.0",
    "recharts": "3.10.1",
    "sonner": "2.0.7",
    "ts-seedrandom": "1.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@grafana/faro-rollup-plugin": "0.11.0",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cheerio": "1.2.0",
    "happy-dom": "20.11.1",
    "i18next-cli": "1.67.7",
    "knip": "6.31.0",
    "rollup-plugin-visualizer": "7.0.1",
    "sass": "1.102.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-devtools-json": "1.1.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreBinaries": [
      "biome",
      "oxlint"
    ],
    "entry": [
      "scripts/*.ts",
      "app/**/*page.tsx!",
      "app/**/*layout.tsx!"
    ],
    "project": [
      "app/**/*.{ts,tsx}!"
    ]
  }
}
