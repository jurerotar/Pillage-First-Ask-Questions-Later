{
  "name": "@pillage-first/engine-wasm",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "default": "./build/client.mjs"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./build/client.mjs"
    },
    "./engine": {
      "types": "./src/engine.d.ts",
      "default": "./build/engine.mjs"
    }
  },
  "scripts": {
    "benchmark": "node benchmarks/engine.ts",
    "benchmark:all": "node benchmarks/run.ts",
    "benchmark:quick": "node benchmarks/run.ts --quick",
    "benchmark:bridge": "node benchmarks/bridge.ts",
    "benchmark:browser": "node benchmarks/browser.ts",
    "test:benchmarks": "vitest run --project benchmarks",
    "bundle": "node scripts/bundle.ts",
    "build": "node scripts/build.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:scripts": "vitest run --project scripts",
    "test:unit": "vitest run --project unit",
    "test:engine": "vitest run --project engine"
  },
  "dependencies": {
    "@pillage-first/api": "*",
    "@pillage-first/utils": "*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/plugin-transform-block-scoping": "8.0.7",
    "@pillage-first/db": "*",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@types/node": "25.9.1",
    "esbuild": "0.28.2",
    "rolldown": "1.1.5",
    "vitest": "5.0.3"
  }
}
