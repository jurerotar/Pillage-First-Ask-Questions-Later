{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@pillage-first/db",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Jure Rotar <hello@jurerotar.com>",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurerotar/Pillage-First-Ask-Questions-Later",
    "directory": "packages/db"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint:check": "biome lint --no-errors-on-unmatched",
    "lint": "biome lint --fix --no-errors-on-unmatched",
    "lint:check/oxlint": "oxlint --type-aware",
    "lint/oxlint": "oxlint --type-aware --fix",
    "format:check": "biome ci --linter-enabled=false",
    "format": "biome check --write --no-errors-on-unmatched",
    "knip": "knip",
    "test": "vitest",
    "type-check": "tsc"
  },
  "dependencies": {
    "@pillage-first/game-assets": "*",
    "@pillage-first/types": "*",
    "@pillage-first/utils": "*",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "ts-seedrandom": "1.6.0"
  },
  "devDependencies": {
    "knip": "6.33.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zod": "4.5.1"
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreBinaries": [
      "biome",
      "oxlint"
    ],
    "project": [
      "src/**/*.ts!"
    ]
  }
}
