{
  "$schema": "node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "allow"
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "import",
    "vitest",
    "jest",
    "oxc",
    "promise"
  ],
  "jsPlugins": ["./plugins/oxlint/file-colocation-plugin.ts"],
  "categories": {
    "correctness": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [".turbo", "node_modules"],
  "rules": {
    "eslint/no-await-in-loop": "warn",
    "eslint/no-shadow": "warn",
    "eslint/no-underscore-dangle": "off",
    "eslint/id-length": "off",
    "eslint/max-statements": "off",
    "eslint/no-ternary": "off",
    "eslint/no-console": [
      "error",
      {
        "allow": ["error"]
      }
    ],
    "eslint/max-lines-per-function": "off",
    "eslint/max-lines": "off",
    "eslint/one-var": "off",
    "eslint/complexity": "off",
    "eslint/max-depth": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/arrow-body-style": "off",
    "eslint/sort-keys": "off",
    "eslint/max-params": "off",
    "eslint/no-continue": "off",
    "eslint/no-new": "off",
    "eslint/no-bitwise": "off",
    "eslint/no-labels": "off",
    "eslint/capitalized-comments": "off",
    "eslint/no-undefined": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-inline-comments": "off",
    "eslint/sort-imports": "off",
    "eslint/no-implicit-coercion": [
      "error",
      {
        "allow": ["!!"]
      }
    ],
    "eslint/no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "caughtErrors": false
      }
    ],
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/promise-function-async": "warn",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/consistent-return": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-confusing-void-expression": [
      "off",
      {
        "ignoreArrowShorthand": true
      }
    ],
    "unicorn/no-null": "off",
    "unicorn/new-for-builtins": "off",
    "unicorn/no-lonely-if": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/prefer-number-coercion": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/no-await-expression-member": "off",
    "unicorn/require-post-message-target-origin": "off",
    "unicorn/prefer-string-slice": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/no-unreadable-array-destructuring": "off",
    "import/default": "off",
    "import/no-relative-parent-imports": "off",
    "import/prefer-default-export": "off",
    "import/no-named-export": "off",
    "import/group-exports": "off",
    "import/unambiguous": "off",
    "import/exports-last": "off",
    "import/max-dependencies": "off",
    "import/consistent-type-specifier-style": "off",
    "import/no-unassigned-import": "off",
    "import/extensions": [
      "error",
      "never",
      {
        "ignorePackages": true,
        "pattern": {
          "css": "always",
          "sql": "always",
          "wasm": "always",
          "md": "always",
          "mdx": "always",
          "scss": "always",
          "json": "always"
        }
      }
    ],
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/prefer-called-once": "off",
    "vitest/prefer-called-exactly-once-with": "off",
    "vitest/prefer-called-times": "error",
    "vitest/valid-title": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/require-test-timeout": "off",
    "vitest/require-top-level-describe": "off",
    "vitest/prefer-to-be-truthy": "off",
    "vitest/prefer-strict-boolean-matchers": "error",
    "vitest/prefer-to-be": "off",
    "vitest/prefer-to-be-falsy": "off",
    "vitest/max-expects": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/prefer-expect-assertions": "off",
    "vitest/consistent-test-it": ["error", { "fn": "test" }],
    "jest/valid-expect": "off",
    "jest/valid-title": "off",
    "jest/require-hook": "off",
    "jest/require-top-level-describe": "off",
    "jest/max-expects": "off",
    "jest/prefer-to-be": "off",
    "jest/require-to-throw-message": "off",
    "jest/prefer-expect-assertions": "off",
    "jest/prefer-ending-with-an-expect": "off",
    "jest/prefer-called-with": "off",
    "jest/prefer-lowercase-title": "warn",
    "jest/no-conditional-in-test": "off",
    "jest/consistent-test-it": [
      "error",
      {
        "fn": "test"
      }
    ],
    "oxc/no-async-await": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-map-spread": "off",
    "promise/avoid-new": "off",
    "promise/no-multiple-resolved": "off",
    "promise/prefer-await-to-callbacks": "off",
    "file-colocation-plugin/colocation": [
      "warn",
      {
        "ignore": [
          "app/components/head-links.tsx",
          "app/components/icon.tsx",
          "app/components/page-contents.tsx",
          "app/components/text.tsx",
          "app/components/tooltip.tsx"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/vite.config.ts"],
      "rules": {
        "import/extensions": "off"
      }
    },
    {
      "files": ["**/*.config.ts"],
      "rules": {
        "import/no-nodejs-modules": "off",
        "import/no-default-export": "off",
        "import/prefer-default-export": "error",
        "import/no-named-export": "error"
      }
    }
  ]
}
