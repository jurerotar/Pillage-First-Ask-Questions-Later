{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@pillage-first/web",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Jure Rotar <hello@jurerotar.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurerotar/Pillage-First-Ask-Questions-Later",
    "directory": "apps/web"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:dev": "react-router build --mode development",
    "preview": "vite preview",
    "lint:check": "biome lint --no-errors-on-unmatched",
    "lint": "biome lint --fix --no-errors-on-unmatched",
    "lint:check/oxlint": "oxlint",
    "lint/oxlint": "oxlint --fix",
    "format:check": "biome ci --linter-enabled=false",
    "format": "biome check --write --no-errors-on-unmatched",
    "knip": "knip",
    "localize": "i18next-cli extract",
    "type-check": "node ../../scripts/generate-api-route-types.ts && react-router typegen && tsc",
    "test": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@grafana/faro-react": "2.14.0",
    "@grafana/faro-web-sdk": "2.14.0",
    "@hookform/resolvers": "7.0.8",
    "@mantine/hooks": "9.8.2",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@pillage-first/api": "*",
    "@pillage-first/game-assets": "*",
    "@pillage-first/graphics": "0.4.0-rc10",
    "@pillage-first/mocks": "*",
    "@pillage-first/types": "*",
    "@pillage-first/utils": "*",
    "@react-router/node": "8.5.2",
    "@react-router/serve": "8.5.2",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-query": "5.108.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "27.2.2",
    "moderndash": "4.0.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "react-icons": "5.7.0",
    "react-icons-sprite": "1.4.1-rc1",
    "react-router": "8.5.2",
    "react-tooltip": "5.30.0",
    "react-window": "2.5.4",
    "sonner": "2.0.8",
    "ts-seedrandom": "1.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@grafana/faro-rollup-plugin": "0.13.2",
    "@react-router/dev": "8.5.2",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "happy-dom": "21.0.4",
    "i18next-cli": "1.93.3",
    "knip": "6.47.0",
    "sass": "1.108.2",
    "tailwindcss": "4.3.5",
    "tailwindcss-safe-area": "2.0.0",
    "typescript": "7.1.0-beta",
    "vite": "8.3.8",
    "vite-plugin-devtools-json": "1.1.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreBinaries": [
      "biome",
      "oxlint"
    ],
    "entry": [
      "scripts/*.ts",
      "app/**/*page.tsx!",
      "app/**/*layout.tsx!"
    ],
    "project": [
      "app/**/*.{ts,tsx}!"
    ]
  }
}
