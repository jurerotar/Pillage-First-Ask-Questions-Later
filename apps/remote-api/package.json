{
  "name": "@pillage-first/remote-api",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "remote-api": "node --watch --env-file=.env src/server.ts",
    "start": "node src/server.ts",
    "type-check": "tsc --noEmit",
    "lint:check": "biome lint --no-errors-on-unmatched",
    "lint": "biome lint --fix --no-errors-on-unmatched",
    "lint:check/oxlint": "oxlint .",
    "lint/oxlint": "oxlint --fix .",
    "format:check": "biome ci --linter-enabled=false",
    "format": "biome check --write --no-errors-on-unmatched",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
