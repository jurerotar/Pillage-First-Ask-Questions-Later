{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "pillage-first",
  "version": "0.4.38",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Jure Rotar <hello@jurerotar.com>",
  "repository": "github:jurerotar/Pillage-First-Ask-Questions-Later",
  "bugs": "https://github.com/jurerotar/Pillage-First-Ask-Questions-Later/issues",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "inject-graphics": "node scripts/inject-graphics.ts",
    "extract-sql-schema": "node scripts/extract-sql-schema.ts",
    "extract-sql-usage": "node scripts/extract-sql-usage.ts",
    "extract-sql-seeder-usage": "node scripts/extract-sql-seeder-usage.ts",
    "generate-screenshots": "node scripts/generate-screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.61.1",
    "@typescript/native-preview": "7.0.0-dev.20260615.1",
    "lefthook": "2.1.9",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "playwright": "1.61.1",
    "sharp": "0.35.3",
    "turbo": "2.10.4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "vite-plugin-devtools-json": {
      "vite": "8.1.3"
    },
    "vite-plugin-pwa": {
      "vite": "8.1.3"
    },
    "openapi-typescript": {
      "typescript": "6.0.3"
    }
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        0
      ],
      "body-max-line-length": [
        0
      ]
    }
  },
  "allowScripts": {
    "@swc/core": true,
    "sharp": true,
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "core-js-pure": false,
    "esbuild": false,
    "lefthook": false,
    "@tree-sitter-grammars/tree-sitter-yaml": false,
    "tree-sitter-json": false
  }
}
