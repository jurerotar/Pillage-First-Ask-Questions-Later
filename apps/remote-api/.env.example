PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
APP_DATA_DIRECTORY=C:/pillage-first-data/remote-api
UPLOAD_URL_SECRET=replace-with-a-random-32-byte-base64url-secret
API_TOKEN=replace-with-a-random-32-byte-base64url-token
# Comma-separated origins; each must include its scheme and optional port.
ALLOWED_ORIGIN=http://localhost:5173,https://pillagefirst.com
# Set to 0 to keep report upload capabilities from expiring.
UPLOAD_LINK_TTL_MINUTES=1440
MAX_FILE_BYTES=262144000
MAX_REPORT_BYTES=262144000
MAX_CHUNK_BYTES=8388608
