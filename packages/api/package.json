{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@pillage-first/api",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Jure Rotar <hello@jurerotar.com>",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurerotar/Pillage-First-Ask-Questions-Later",
    "directory": "packages/api"
  },
  "exports": {
    ".": {
      "default": "./src/worker/api-worker.ts"
    },
    "./api-route-types": {
      "default": "./src/http/api-route-types.generated.d.ts"
    },
    "./db": {
      "default": "./src/db/index.ts"
    },
    "./testing": {
      "default": "./src/db/testing/index.ts"
    }
  },
  "scripts": {
    "lint:check": "biome lint --no-errors-on-unmatched",
    "lint": "biome lint --fix --no-errors-on-unmatched",
    "lint:check/oxlint": "oxlint .",
    "lint/oxlint": "oxlint --fix .",
    "format:check": "biome ci --linter-enabled=false",
    "format": "biome check --write --no-errors-on-unmatched",
    "knip": "knip",
    "type-check": "tsc",
    "test": "vitest"
  },
  "dependencies": {
    "@pillage-first/game-assets": "*",
    "@pillage-first/types": "*",
    "@pillage-first/utils": "*",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "moderndash": "4.0.2",
    "path-to-regexp": "8.4.2",
    "ts-seedrandom": "1.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "knip": "6.42.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
      "src/http/api-routes.ts"
    ],
    "ignoreBinaries": [
      "biome",
      "oxlint"
    ],
    "project": [
      "src/**/*.ts!"
    ]
  }
}
